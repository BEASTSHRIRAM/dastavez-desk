# Database. Leave unset for a local SQLite file; use Postgres for production.
# DATABASE_URL=postgresql+psycopg://dastavez:dastavez@localhost:5432/dastavez
SECRET_KEY=change-me-in-production
STORAGE_DIR=./storage

# AI providers: "demo" (deterministic, no credentials) | "anthropic" | "openai"
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=
# STT providers: "demo" | "openai" (OpenAI-compatible /audio/transcriptions)
STT_PROVIDER=demo
STT_API_KEY=

# Optional: path to LibreOffice's soffice binary for DOCX -> PDF
SOFFICE_PATH=
