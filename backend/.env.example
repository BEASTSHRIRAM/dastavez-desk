# Database. Leave unset for a local SQLite file; use Postgres for production.
# DATABASE_URL=postgresql+psycopg://dastavez:dastavez@localhost:5432/dastavez
# Supabase: paste the connection string from Project Settings > Database (Session pooler or Direct).
# postgres:// and postgresql:// forms are accepted and sslmode=require is added automatically.
# DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Set false on a real deployment so no fictional demo logins are created.
SEED_DEMO=true
SECRET_KEY=change-me-in-production
STORAGE_DIR=./storage

# AI providers: "demo" (deterministic, no credentials) | "groq" | "anthropic" | "openai"
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_MODEL=
# STT providers: "demo" | "groq" | "openai"
STT_PROVIDER=demo
STT_API_KEY=

# Optional: path to LibreOffice's soffice binary for DOCX -> PDF
SOFFICE_PATH=
